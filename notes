Here are all the SQL queries for GCAP:

1. Column rename (run first if not done yet):


ALTER TABLE parking_bookings
  CHANGE COLUMN passengers vehicle_no INT(11) DEFAULT NULL;
2. Full setup script — copy from gcap-setup.sql or paste this:


-- 1. Company
INSERT INTO `companies`
  (`id`, `name`, `email`, `domain`, `address`, `mobile_no`,
   `business_type`, `business_catrgory`, `status`, `active`,
   `ref_prefix`, `support_email_address`, `data_from`)
VALUES
  (25, 'GCAP Airport Parking', 'support@gcapairportparking.co.uk',
   'gcapairportparking.co.uk', 'Bristol, United Kingdom', '01179000000',
   'individual', 'portal', 'active', 1,
   'GCAP', 'support@gcapairportparking.co.uk', 'A')
ON DUPLICATE KEY UPDATE `domain` = VALUES(`domain`), `active` = VALUES(`active`);

-- 2. Airport
INSERT INTO `airport_data`
  (`airport_id`, `airport_name`, `iata_code`, `icao_code`,
   `country`, `city`, `total_terminals`, `airport_type`, `website`, `company_id`)
VALUES
  (10, 'Bristol', 'BRS', 'EGGD', 'United Kingdom', 'Bristol', 2, 'Public',
   'https://www.bristolairport.co.uk', 25)
ON DUPLICATE KEY UPDATE `airport_name` = VALUES(`airport_name`);

-- 3. Terminals
INSERT INTO `parking_terminals`
  (`terminal_id`, `airport_id`, `terminal_name`, `terminal_code`,
   `availability`, `gate_count`, `operational_status`)
VALUES
  (10, 10, 'Main Terminal', 'T1', 'Open', 20, 'Operational'),
  (11, 10, 'North Terminal', 'NT', 'Open', 10, 'Operational')
ON DUPLICATE KEY UPDATE `operational_status` = VALUES(`operational_status`);

